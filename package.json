{
  "name": "dsh-vision",
  "version": "0.4.3",
  "type": "module",
  "description": "Give any DSH session the ability to read images by routing them through a vision-capable model the host already has, with a settings panel for status, routing, switches and call statistics.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "image",
    "ocr",
    "screenshot",
    "multimodal"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  }
}
